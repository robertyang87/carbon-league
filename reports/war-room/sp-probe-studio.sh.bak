#!/bin/bash
# Self-play generation probe -- Mac Studio via L20 hop (cloud-assistant -> L20 -> ssh Studio).
# Marker: SPROBE-STUDIO1. Window: 20 games or 180s, whichever first.
# Player: cnet2_search.make_search_agent + 13-key pack CONF (SEARCH off),
# weights cnet2_m3s2r1L.npz (md5 b6db08c9b076257c54817377bb93130d). selfplay_gen.py bytes are embedded
# below as base64 and md5-asserted before running (== repo draft 0767d73e9ff1c979a97e97d032e7a138).
# Studio is macOS: no GNU timeout, no setsid in non-interactive ssh PATH;
# use nohup + ConnectTimeout + L20-side timeout cap. L20 is a hop only:
# never touch the snipe_n1 processes on L20.
MARK=SPROBE-STUDIO1
set -eu
echo "$MARK L20-BEGIN $(date '+%F %T %Z')"
SSHK="-i /root/.ssh/dgx_access -o BatchMode=yes -o ConnectTimeout=20 -o UserKnownHostsFile=/root/.jishubuddy/network-checks/studio-known-hosts-20261112"
PERR=/tmp/sprobe_studio_pre.err
PRC=0
POUT=$(timeout -k 30 120 ssh $SSHK arm@10.211.43.68 'echo STUDIO-REACHABLE; hostname; sysctl -n hw.ncpu; sysctl -n hw.memsize' 2>$PERR) || PRC=$?
if [ $PRC -ne 0 ] || ! echo "$POUT" | grep -q STUDIO-REACHABLE; then
  echo "$MARK FAIL precheck rc=$PRC"; tail -5 $PERR; echo "$MARK L20-END"; exit 1
fi
echo "PRECHECK OK: $POUT"
RC=0
timeout -k 30 420 ssh $SSHK arm@10.211.43.68 'bash -s' <<'STEOF' || RC=$?
set -u
MARK=SPROBE-STUDIO1
VENV=$HOME/junyang/carbon/.venv/bin/python
DGX=arm@10.188.0.23
die() { echo "$MARK FAIL $1 rc=$2"; echo "$MARK STUDIO-END"; exit 1; }
echo "$MARK STUDIO-BEGIN $(date '+%F %T %Z')"
if [ ! -x "$VENV" ]; then die no-venv-python 1; fi
echo "VENV $($VENV -c 'import sys; print(sys.version.split()[0])')"
echo "CPU: $(sysctl -n hw.ncpu) cores; MEM: $(( $(sysctl -n hw.memsize) / 1073741824 ))Gi; LOAD: $(uptime | sed 's/.*load averages: //')"
CODE=$HOME/junyang/carbon/code
if [ ! -f "$CODE/cnet2_search.py" ] || [ ! -f "$CODE/fastsim.py" ] || [ ! -f "$CODE/eval_v53.py" ] || [ ! -f "$CODE/cnet2_feat.py" ] || [ ! -f "$CODE/cnet2_np.py" ] || [ ! -f "$CODE/env_src/carbon_challenge-master/zerosum_env/envs/carbon/carbon.json" ]; then
  echo "CODE-INCOMPLETE, rsyncing code from DGX over LAN (rsync -e without -n: ssh stdin IS the rsync pipe)"
  mkdir -p "$CODE"
  rsync -avz --partial -e "ssh -o BatchMode=yes -o ConnectTimeout=20" $DGX:/home/arm/junyang/carbon-repo/code/ "$CODE/" || die rsync-code $?
fi
for f in cnet2_search.py fastsim.py eval_v53.py cnet2_feat.py cnet2_np.py; do
  echo "CODEMD5 $f $(md5 -q "$CODE/$f")"
done
WTS=$HOME/junyang/carbon/data/weights/cnet2_m3s2r1L.npz
if [ ! -f "$WTS" ]; then
  echo "WEIGHTS-MISSING locally, fetching from DGX over LAN"
  mkdir -p $HOME/junyang/carbon/data/weights
  scp -o BatchMode=yes -o ConnectTimeout=20 -o StrictHostKeyChecking=accept-new $DGX:/home/arm/junyang/carbon/data/weights/cnet2_m3s2r1L.npz "$WTS" || die scp-weights $?
fi
echo "WEIGHTS $WTS $(md5 -q "$WTS")"
if [ "$(md5 -q "$WTS")" != "b6db08c9b076257c54817377bb93130d" ]; then die weights-md5-mismatch 1; fi
cat > /tmp/selfplay_gen.py.b64 <<'B64EOF'

B64EOF
base64 -D /tmp/selfplay_gen.py.b64 > "$CODE/selfplay_gen.py" || die b64-decode 1
if [ "$(md5 -q "$CODE/selfplay_gen.py")" != "0767d73e9ff1c979a97e97d032e7a138" ]; then die script-md5-mismatch 1; fi
echo "SCRIPT-OK $CODE/selfplay_gen.py md5=0767d73e9ff1c979a97e97d032e7a138"
WORKERS=$(( $(sysctl -n hw.ncpu) - 2 ))
echo "WORKERS=$WORKERS LOAD-BEFORE: $(uptime | sed 's/.*load averages: //')"
"$VENV" "$CODE/selfplay_gen.py" --weights "$WTS" --seed0 991000 --seed1 991200 --out $HOME/junyang/carbon/data/selfplay_probe/studio --workers "$WORKERS" --max-games 20 --max-seconds 180 --name m3s2r1 > /tmp/sprobe_studio.log 2>&1
RC2=$?
cat /tmp/sprobe_studio.log
echo "LOAD-AFTER: $(uptime | sed 's/.*load averages: //')"
grep -E "SPGEN-RESULT" /tmp/sprobe_studio.log || die no-SPGEN-RESULT $RC2
echo "$MARK STUDIO-END rc=$RC2"
exit $RC2
STEOF
echo "$MARK L20-END rc=$RC"
if [ $RC -ne 0 ]; then echo "$MARK FAIL ssh-leg rc=$RC"; exit 1; fi
exit 0
