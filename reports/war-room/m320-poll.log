2026-11-12T13:32:27.4232804Z #!/bin/bash
2026-11-12T13:32:27.4233499Z # replica_chain.sh -- SINGLE-CHAIN replica pipeline (2026-11-12, anti-idle rule).
2026-11-12T13:32:27.4234324Z #
2026-11-12T13:32:27.4234809Z # One script, one executor, start to finish:
2026-11-12T13:32:27.4235999Z #   wait READY -> count assertion -> build -> set_uw -> dual-arm launch -> attestation
2026-11-12T13:32:27.4237159Z # A replica job must NEVER be split into "dataset agent finishes, training waits
2026-11-12T13:32:27.4238855Z # for a second dispatch" again (M7Bs v2 lesson: ds_m7bs_v2 built 17:31, GPU idle
2026-11-12T13:32:27.4240046Z # 16:51->17:58, executor silent past deadline; see reports/live/replica_gap_plan.md).
2026-11-12T13:32:27.4240887Z #
2026-11-12T13:32:27.4243783Z # COMPLETION DEFINITION (binding): the executor is DONE only when the training
2026-11-12T13:32:27.4244803Z # trio is LIVE (both PIDs registered + GPU busy + fresh logs/weights) AND the
2026-11-12T13:32:27.4246103Z # attestation block (processes/GPU/logs/counts) is printed into this script's
2026-11-12T13:32:27.4247599Z # own log. "Dataset built" is NOT completion. The receipt must be delivered
2026-11-12T13:32:27.4248439Z # within one watch cycle (15 min) of launch -- M7Bs v2 also proved the reverse
2026-11-12T13:32:27.4249029Z # failure: training WAS launched 17:58 but the receipt never arrived, which is
2026-11-12T13:32:27.4249597Z # indistinguishable from not launching. Silence = handoff not established.
2026-11-12T13:32:27.4250036Z #
2026-11-12T13:32:27.4250314Z # Usage (run from code/, on the training box):
2026-11-12T13:32:27.4250729Z #   PREFIX=m7bsv2 TEACHER='RyanX-AIPowercore-M7Bs-b010' \
2026-11-12T13:32:27.4251237Z #   CORPUS=$DATA/m7bs_corpus MATCHES=$DATA/m7bs_matches.json DS=$DATA/ds_m7bs_v2 \
2026-11-12T13:32:27.4251840Z #   EXPECTED=142 ./replica_chain.sh 2>&1 | tee $DATA/dq_logs/replica_chain_m7bsv2.log
2026-11-12T13:32:27.4252300Z #
2026-11-12T13:32:27.4252632Z # Required env: PREFIX, TEACHER (exact leaderboard name), CORPUS, DS
2026-11-12T13:32:27.4253132Z # Optional env: MATCHES (matches .json for the count assertion),
2026-11-12T13:32:27.4253640Z #   EXPECTED (expected games; default = index entries after assertion),
2026-11-12T13:32:27.4254139Z #   READY_FILE (wait until this file exists), WAIT_MIN (default 60),
2026-11-12T13:32:27.4254643Z #   SYNC_CMD (API re-pull command run ONCE inside this same run when counts
2026-11-12T13:32:27.4255206Z #             mismatch, e.g. "../.venv/bin/python ladder_corpus.py $CORPUS '<teacher-id>'";
2026-11-12T13:32:27.4256332Z #             ladder_corpus.sync() re-pulls matches+replays from the ladder API
2026-11-12T13:32:27.4257021Z #             and rewrites index.json),
2026-11-12T13:32:27.4257705Z #   REPO_DIR + REPO_MATCHES (repo copy of the matches list; on mismatch the
2026-11-12T13:32:27.4258540Z #             repo is pulled (timeout 60) and the fresher matches list copied in
2026-11-12T13:32:27.4259238Z #             before the API re-pull attempt),
2026-11-12T13:32:27.4259915Z #   EPOCHS (default 20), BC_THREADS (default 5), BC_DEVICE (default cuda).
2026-11-12T13:32:27.4260587Z set -u
2026-11-12T13:32:27.4261000Z D=${DATA:-/home/arm/junyang/carbon/data}
2026-11-12T13:32:27.4261567Z : "${PREFIX:?set PREFIX e.g. m7bsv2}"
2026-11-12T13:32:27.4262189Z : "${TEACHER:?set TEACHER exact leaderboard name}"
2026-11-12T13:32:27.4262949Z : "${CORPUS:?set CORPUS dir (contains index.json and replays/)}"
2026-11-12T13:32:27.4263612Z : "${DS:?set DS output dataset dir}"
2026-11-12T13:32:27.4264289Z EPOCHS=${EPOCHS:-20}; WAIT_MIN=${WAIT_MIN:-60}
2026-11-12T13:32:27.4264890Z LOGD=$D/dq_logs; mkdir -p "$LOGD" "$D/weights"
2026-11-12T13:32:27.4266112Z mark() { echo "REPLICA-CHAIN[$PREFIX] $* $(date '+%F %T %Z')"; }
2026-11-12T13:32:27.4266601Z 
2026-11-12T13:32:27.4266842Z counts() {  # prints "replays matches index"
2026-11-12T13:32:27.4267501Z   local rp=$(ls "$CORPUS"/replays/*.json.gz 2>/dev/null | wc -l)
2026-11-12T13:32:27.4268224Z   local mt=-1; [ -n "${MATCHES:-}" ] && [ -f "$MATCHES" ] && \
2026-11-12T13:32:27.4269345Z     mt=$(../.venv/bin/python -c "import json,sys;print(len(json.load(open(sys.argv[1]))))" "$MATCHES" 2>/dev/null || echo -1)
2026-11-12T13:32:27.4270837Z   local ix=$(../.venv/bin/python -c "import json,sys;print(len(json.load(open(sys.argv[1]))))" "$CORPUS/index.json" 2>/dev/null || echo -1)
2026-11-12T13:32:27.4271881Z   echo "$rp $mt $ix"
2026-11-12T13:32:27.4272336Z }
2026-11-12T13:32:27.4272559Z 
2026-11-12T13:32:27.4273185Z echo '--- 1) WAIT-READY (file + GPU free; network ops timeout-wrapped) ---'
2026-11-12T13:32:27.4273983Z for i in $(seq 1 "$WAIT_MIN"); do
2026-11-12T13:32:27.4274502Z   READY=1
2026-11-12T13:32:27.4275029Z   [ -n "${READY_FILE:-}" ] && [ ! -f "$READY_FILE" ] && READY=0
2026-11-12T13:32:27.4275986Z   pgrep -f 'cnet2_train[.]py' >/dev/null 2>&1 && READY=0
2026-11-12T13:32:27.4276674Z   [ "$READY" = 1 ] && { mark "READY at wait-min $i"; break; }
2026-11-12T13:32:27.4277503Z   [ "$i" = "$WAIT_MIN" ] && { mark "FAIL not READY after ${WAIT_MIN}min"; exit 1; }
2026-11-12T13:32:27.4278455Z   sleep 60
2026-11-12T13:32:27.4278867Z POLL-DONE
2026-11-12T13:32:27.4279268Z ssh-rc=0
2026-11-12T13:32:27.4279659Z M320POLL2132_END
