2026-11-12T09:32:08.3519336Z def _tdist(a, b):                 # torus Manhattan distance on the 15x15 board
2026-11-12T09:32:08.3519704Z     dr = abs(a // 15 - b // 15); dc = abs(a % 15 - b % 15)
2026-11-12T09:32:08.3520002Z     return min(dr, 15 - dr) + min(dc, 15 - dc)
2026-11-12T09:32:08.3520182Z 
2026-11-12T09:32:08.3520187Z 
2026-11-12T09:32:08.3520369Z def _cheb(a, b):                  # torus Chebyshev distance (1 = one of the 8 neighbours)
2026-11-12T09:32:08.3521330Z     dr = abs(a // 15 - b // 15); dc = abs(a % 15 - b % 15)
2026-11-12T09:32:08.3521629Z     return max(min(dr, 15 - dr), min(dc, 15 - dc))
